{
  "appId": "com.krypts.desktop",
  "productName": "Krypts DRM",
  "copyright": "Copyright © 2025 Krypts",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "electron-preload.js",
    "public/**/*",
    "node_modules/**/*",
    "!node_modules/.bin",
    "!node_modules/electron-builder/**/*",
    "!**/*.map"
  ],
  "extraResources": [
    {
      "from": ".next",
      "to": ".next",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Krypts DRM"
  }
}
