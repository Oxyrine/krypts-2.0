# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/krypts_drm

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-very-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# S3-compatible storage
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET_NAME=krypts-protected-content

# Admin
ADMIN_EMAIL=admin@example.com

# Security
RAPID_SESSION_THRESHOLD_SECONDS=120
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
